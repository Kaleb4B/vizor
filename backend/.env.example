# Server Configuration
NODE_ENV=development
PORT=4000

# PostgreSQL Database (Metdata & Auth)
DATABASE_URL="postgresql://postgres:postgres@localhost:5921/web_security?schema=public"

# ClickHouse Database (Time-Series & Analytics)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=vizor
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Kafka Message Broker
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=vizor-api
KAFKA_TOPIC_EVENTS=vizor.click_events
KAFKA_GROUP_REALTIME=vizor.group.realtime
KAFKA_GROUP_FINGERPRINT=vizor.group.fingerprint
KAFKA_GROUP_ANALYTICS=vizor.group.analytics

# Redis In-Memory Cache
REDIS_URL=redis://:vizor_redis_secret@localhost:6379

# Security & JWT Tokens
JWT_SECRET=your_jwt_super_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# Webhook Security
WEBHOOK_SECRET=your_webhook_hmac_secret_here

# CORS Origin
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
